# AI = Gemma 4 on this laptop via Ollama (`ollama pull gemma4:e2b-it-qat`). Without Ollama the app still routes offline.
GEMMA_MODEL=gemma4:e2b-it-qat
OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model in memory between visitors (default 5m is too short for a demo).
OLLAMA_KEEP_ALIVE=2h
# Demo only: shows a button that pretends 10 people are walking a route (never enable on a public server).
# RAASTA_DEMO=1

# Password for the staff admin panel at /admin.html (rename rooms, notice line). Panel is off when empty.
ADMIN_PASSWORD=

# Team-only link to read visitor feedback: /api/feedback?key=<this>
FEEDBACK_KEY=

# Alternative for a cloud host (Vercel): Gemma 4 through Google's Gemini API instead of Ollama. Key from https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-26b-a4b-it

# Backup when Gemma is slow or fails: Claude through the Anthropic API. With a key set, the cloud Gemma gets
# GEMMA_WAIT_MS (default 5000) and then Claude answers. Key from https://platform.claude.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_VISION_MODEL=   (photos; defaults to CLAUDE_MODEL)
# GEMMA_WAIT_MS=5000

# Cloudinary (mandatory for Hacktober HackDays): real step photos get faces blurred and the arrow + Hindi/English
# line painted on. Cloud name from the Cloudinary dashboard; an UNSIGNED upload preset (Settings → Upload).
# Then once: node --env-file=.env tools/cld-upload.mjs
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=raasta
